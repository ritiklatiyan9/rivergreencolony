{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/booking/[...path].js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/plot-manager", "destination": "/index.html" }
  ]
}
