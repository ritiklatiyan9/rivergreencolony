{
  "name": "rivergreen-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test:server": "node --test server/*.test.mjs",
    "test:scene": "node --test src/data/sceneLandscape.test.js",
    "test:map": "node --test src/data/colonyLocation.test.js src/scene/colonyMapCamera.test.js src/scene/colonyMapPlacement.test.js src/data/colonySiteFit.test.js src/data/colonyFrontage.test.js src/scene/colonyMapFit.test.js src/scene/architecture-map-fit.test.js src/scene/architecture-frontage.test.js src/scene/life-frontage.test.js",
    "test:seo": "node --test src/data/seo.test.js",
    "test:booking": "node --test server/booking-proxy.test.mjs src/data/bookingAvailability.test.js src/scene/colonyPlotPicker.test.js"
  },
  "dependencies": {
    "framer-motion": "^12.23.0",
    "gsap": "^3.14.0",
    "locomotive-scroll": "^5.0.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0"
  }
}
