# Free satellite map; no API key or billing account is required.
# Register the layout plane to the four imagery perimeter corners by default.
# Complete 3D buildings/fountain keep uniform local proportions.
VITE_COLONY_MAP_FIT_TO_SITE=true
VITE_COLONY_MAP_ALTITUDE=0.35
# Optional manual placement (used when FIT_TO_SITE=false).
VITE_COLONY_MAP_LAT=29.470062042354932
VITE_COLONY_MAP_LNG=77.29512691497803
VITE_COLONY_MAP_HEADING=301.71802239454354
VITE_COLONY_MAP_METRES_PER_UNIT=6.132966435829427
# Optional replacement MapLibre style; default is satellite imagery.
# Keep its provider attribution. Example street-map override:
# VITE_COLONY_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
